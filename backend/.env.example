# ── مفاتيح الذكاء الاصطناعي (اختيارية) ──
# يكفي مفتاح واحد فقط. بدون أي مفتاح يعمل الباكند بالمحرّك الاحتياطي.

# الخيار 1: Google Gemini — مجاني بدون بطاقة (aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# الخيار 2: Anthropic Claude — يحتاج رصيد مدفوع (console.anthropic.com)
ANTHROPIC_API_KEY=
# MIJHAR_MODEL=claude-sonnet-5

# ملاحظة: إن وُجد مفتاح Claude فله الأولوية، وإلا يُستخدم Gemini.

# منفذ الخادم
PORT=8787
