# ── مفاتيح الذكاء الاصطناعي (اختيارية) ──
# يكفي مفتاح واحد فقط. بدون أي مفتاح يعمل الباكند بالمحرّك الاحتياطي.

# الخيار 1: Google Gemini — مجاني (aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# الخيار 2: Groq — مجاني بدون بطاقة وحصته أكرم (console.groq.com)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# الخيار 3: Anthropic Claude — يحتاج رصيد مدفوع (console.anthropic.com)
ANTHROPIC_API_KEY=
# MIJHAR_MODEL=claude-sonnet-5

# الأولوية: Claude ← Gemini ← Groq (أول مفتاح موجود يُستخدم).

# منفذ الخادم
PORT=8787
